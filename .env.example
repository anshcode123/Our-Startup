# ==================================================
# DATABASE (PostgreSQL + Prisma)
# ==================================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/anshul_dev?schema=public"

# ==================================================
# AUTHENTICATION & ADMIN INITIALIZATION
# ==================================================
# Generate a strong random secret (e.g., `openssl rand -base64 32`)
AUTH_SECRET="replace-with-a-strong-random-32-byte-secret"

# Initial admin account (hashed via bcrypt before storing in PostgreSQL)
ADMIN_EMAIL="admin@anshul.dev"
ADMIN_PASSWORD="replace-with-a-strong-admin-password"

# ==================================================
# CLOUD IMAGE STORAGE (Cloudinary)
# ==================================================
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ==================================================
# SERVER / DEPLOYMENT CONFIGURATION (Optional)
# ==================================================
# Standalone Express backend port (default: 4000)
BACKEND_PORT=4000

# Frontend origin allowed by Express CORS (default: http://localhost:3000)
FRONTEND_URL="http://localhost:3000"
