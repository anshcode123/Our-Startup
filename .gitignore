# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*

# local env files — .env*.local already covers .env.local,
# .env.production.local, etc.; .env on its own doesn't end in ".local" so
# it needs its own line (defensive: this project doesn't currently use
# any env files, but this should never accidentally get committed if one
# is added later).
.env
.env*.local

# vercel
.vercel
