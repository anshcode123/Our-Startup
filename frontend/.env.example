# ==================================================
# FRONTEND ENVIRONMENT VARIABLES (Placeholder Only)
# Copy to frontend/.env.local when needed.
# NEVER put private API keys, admin passwords, or database credentials
# in frontend/.env.local or NEXT_PUBLIC_* variables.
# ==================================================

# Express backend base URL for server-side API proxying (default: http://localhost:4000)
BACKEND_URL="http://localhost:4000"

# Shared JWT secret for Edge middleware token verification (optional; falls back to /api/auth/me check)
AUTH_SECRET=""

# Public site URL (optional override)
NEXT_PUBLIC_SITE_URL=""

# Optional ScrollTrigger debug markers in development only ("true" | "false")
NEXT_PUBLIC_SCROLL_DEBUG=false