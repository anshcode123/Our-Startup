rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global site settings document: settings/site
    match /settings/site {
      // Anyone (public visitors, unauthenticated users) can read the site theme
      allow read: if true;

      // Only authenticated administrator can update site settings
      allow write: if request.auth != null && (
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true
      );
    }

    // Default deny for all other documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}